# Copy to .env.local for local development. Real values never go in the repository.

# PostgreSQL connection string.
DATABASE_URL=

# Signs the session cookie. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The site's public address, e.g. https://makaramen.bg (http://localhost:3000 locally).
NEXTAUTH_URL=

# Cloudinary. The API secret stays on the server; uploads are signed by /api/upload-signature.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Name of a *signed* upload preset (Settings → Upload → Upload presets).
CLOUDINARY_UPLOAD_PRESET=

# SMTP for the inquiry and contact forms. If unset, submissions are logged to the
# server console instead of emailed: fine locally, but set them before going live.
# Host, e.g. smtp.gmail.com.
SMTP_HOST=
# 587 for STARTTLS, 465 for implicit TLS.
SMTP_PORT=
SMTP_USER=
# Password, app-specific password or API key.
SMTP_PASS=
# Mailbox that receives the inquiries.
INQUIRY_TO_EMAIL=
