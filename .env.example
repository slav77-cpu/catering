# SMTP configuration for outgoing inquiry/contact form emails (see src/lib/email.ts).
# If these are not set, form submissions are simply logged to the server
# console instead of being emailed — safe for local dev, but must be
# configured before going live so real inquiries actually reach someone.

# Hostname of the SMTP server (e.g. smtp.gmail.com, smtp.mailgun.org).
SMTP_HOST=

# Port of the SMTP server (587 for STARTTLS, 465 for implicit TLS).
SMTP_PORT=

# Username used to authenticate with the SMTP server.
SMTP_USER=

# Password (or app-specific password / API key) used to authenticate with the SMTP server.
SMTP_PASS=

# Destination mailbox that receives restaurant/catering inquiry submissions.
INQUIRY_TO_EMAIL=
